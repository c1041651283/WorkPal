# WorkPal 配置文件
# 位置：%LOCALAPPDATA%\WorkPal\network_config.ini（重新打包后无需重填）
# 修改：托盘 → “编辑配置文件”，在记事本中保存即自动生效
# 格式：每行一个 KEY=值，# 开头的行是注释

# ======================== 网络切换 ========================

# 网卡名称：运行 netsh interface show interface，看“接口名称”一列
WIFI_ADAPTER_NAME=WLAN
ETHERNET_ADAPTER_NAME=以太网

# 要连接的 WiFi 名称（SSID）
# 需先在 Windows 中手动连接过一次并保存密码；WorkPal 使用系统已保存的配置，不保存密码
WIFI_SSID=your_wifi_ssid

# 切换到有线后启动的程序（如检疫客户端），填完整路径；不需要就留空
ETHERNET_PROGRAM_PATH=

# ======================== 代理守护 ========================
# 以下均为默认值；需要修改时删掉行首的 # 再填写

# 公司固定代理，格式：主机名:端口
# VPN_PROXY_SERVER=proxy.ricoh.co.jp:8080

# 启动时及“开启脚本代理”按钮使用的 PAC 地址
# OFFICE_PAC_URL=http://proxy.psh.com.cn/proxy-psh1.pac

# FortiClient.exe 的完整路径；留空时查找默认安装目录
# FORTICLIENT_PATH=

# 检查间隔（秒，30–3600）；托盘“检查间隔”中的选择优先于这里
# PROXY_CHECK_INTERVAL=60

# ======================== DeepSeek Harness ========================
# 托盘“带代理启动 DeepSeek Harness”：只给 DSH 进程设置代理（使用上面的 VPN_PROXY_SERVER），
# 不修改系统或用户环境变量，其他程序不受影响。启动前需先完全退出 DSH。

# DeepSeek Harness.exe 的完整路径；留空时查找 D:\dsh、C:\dsh 等常见位置
# DSH_PATH=D:\dsh\DeepSeek Harness.exe

# 不走代理、直连的地址，逗号分隔；.example.com 表示该域名及其子域名
# 本机回环地址和 DSH 配置中模型接口（baseURL）的主机名会自动加入，无需填写
# 注意：不支持 10.0.0.0/8 这类网段，内网 IP 需逐个填写
# DSH_NO_PROXY=.psh.com.cn,.ricoh.co.jp
